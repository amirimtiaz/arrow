# Arrow worker configuration. Copy to worker/.env and fill in. Never commit .env.

# SpacetimeDB (ops database only — the worker never gets incident-response config)
SPACETIME_HOST=ws://127.0.0.1:3000
SPACETIME_OPS_DB=arrow-ops

# NVIDIA Nemotron (OpenAI-compatible endpoint on build.nvidia.com)
NVIDIA_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3-super-120b-a12b

# Tiger Data (managed TimescaleDB) connection string, e.g. postgres://tsdbadmin:…@….tsdb.cloud.timescale.com:5432/tsdb?sslmode=require
TIGER_DATABASE_URL=

# Analytics API port (the Next.js client proxies /api/worker/* here)
WORKER_PORT=8787
