# Arrow worker configuration. Copy to worker/.env and fill in. Never commit .env.
# The worker runs the Nemotron agents and the Tiger bridge. It needs no inbound port.

# ── SpacetimeDB (ops database only; the worker never gets incident-response config) ──
# `node scripts/setup.mjs --cloud <name>` rewrites these two lines for Maincloud.
SPACETIME_HOST=ws://127.0.0.1:3000
SPACETIME_OPS_DB=arrow-ops
# On cloud hosts without a disk, paste the agent identity token here (from worker/.agent-token-*).
AGENT_TOKEN=

# ── NVIDIA Nemotron (OpenAI-compatible API on build.nvidia.com): all agent reasoning + Ask Arrow ──
NVIDIA_API_KEY=
NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
# on = Nemotron's reasoning trace (shown as "Thinking" steps); off = faster
NEMOTRON_THINKING=on

# ── Tiger Data (managed TimescaleDB): history, analytics, anomaly detection ──
# Use EITHER the full connection string …
TIGER_DATABASE_URL=
# … OR the separate fields from Tiger Console → your service → Connect.
# (Project "client credentials" — the public/secret key pair — are for Tiger's
#  REST API / CLI, not the database, and are NOT used here.)
TIGER_HOST=
TIGER_PORT=
TIGER_USER=tsdbadmin
TIGER_PASSWORD=
TIGER_DB=tsdb
