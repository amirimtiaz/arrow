# Arrow website configuration. Copy to client/.env.local (or set in Vercel → Project → Environment Variables),
# then restart `npm run dev`: NEXT_PUBLIC_* values are read once at startup.

# SpacetimeDB (public values: they only say where to connect). These are the team's live Maincloud databases.
NEXT_PUBLIC_SPACETIME_HOST=wss://maincloud.spacetimedb.com
NEXT_PUBLIC_OPS_DB=arrowdblol-d492m
# Control Tower database. Point NEXT_PUBLIC_IR_HOST at a self-hosted server to keep IR fully isolated.
NEXT_PUBLIC_IR_HOST=wss://maincloud.spacetimedb.com
NEXT_PUBLIC_IR_DB=arrowdblol-d492m-ir

# Local development instead (`spacetime start` + `node scripts/setup.mjs`):
# NEXT_PUBLIC_SPACETIME_HOST=ws://127.0.0.1:3000
# NEXT_PUBLIC_OPS_DB=arrow-ops
# NEXT_PUBLIC_IR_HOST=ws://127.0.0.1:3000
# NEXT_PUBLIC_IR_DB=arrow-ir

# Tiger Data, read server-side by /api/analytics (never sent to the browser). SECRET: get it from a
# teammate privately, never commit it. Without it everything works except the Analytics charts.
TIGER_DATABASE_URL=
