# Arrow website configuration. Copy to client/.env.local (or set in Vercel → Project → Environment Variables).
# `node scripts/setup.mjs --cloud <name>` writes the NEXT_PUBLIC_* lines for Maincloud automatically.

# SpacetimeDB (public values: they only say where to connect)
NEXT_PUBLIC_SPACETIME_HOST=ws://127.0.0.1:3000
NEXT_PUBLIC_OPS_DB=arrow-ops
NEXT_PUBLIC_IR_DB=arrow-ir
# Control Tower server (defaults to the ops server). Point at a self-hosted server to keep IR isolated.
NEXT_PUBLIC_IR_HOST=ws://127.0.0.1:3000

# Tiger Data, read server-side by /api/analytics (never sent to the browser).
TIGER_DATABASE_URL=
