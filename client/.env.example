# Arrow client configuration (public values only). Copy to client/.env.local if you change defaults.
NEXT_PUBLIC_SPACETIME_HOST=ws://127.0.0.1:3000
NEXT_PUBLIC_OPS_DB=arrow-ops
NEXT_PUBLIC_IR_DB=arrow-ir
# Where Next.js proxies /api/worker/* (analytics + agent health)
ARROW_WORKER_URL=http://127.0.0.1:8787
